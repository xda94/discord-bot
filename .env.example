# Copy to .env and fill in. Never commit .env.

# --- Required ---

# Bot: Discord bot token.
DISCORD_TOKEN=
# Bot: the bot's Discord user ID (numeric).
BOT_ID=
# Bot: llama.cpp model aliases; the default must be listed in the allowed list.
LLAMA_CPP_ALLOWED_MODELS=discord-bot
LLAMA_CPP_DEFAULT_MODEL=discord-bot
# API: bind address and port.
HOST=127.0.0.1
PORT=9999
# API: bearer token for data routes (data routes return 503 when unset).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_TOKEN=

# --- Optional (defaults shown) ---

# Storage and logging
# DB_FILE=responses.db
# LOG_DIR=
# LOG_LEVEL=INFO

# Sponsors: password for the /sponsor-set and /sponsor-set-tiers modals.
# SPONSOR_PASSWORD=

# llama.cpp
# LLAMA_CPP_BASE_URL=http://127.0.0.1:8080
# LLAMA_CPP_API_KEY=
# LLAMA_CPP_TIMEOUT=180
# Default: the larger of 600 and LLAMA_CPP_TIMEOUT.
# LLAMA_CPP_VISION_TIMEOUT=600
# Default: .llm-capacity beside DB_FILE.
# LLM_CAPACITY_DIR=
# Default: LLAMA_CPP_DEFAULT_MODEL.
# MENTION_LLAMA_CPP_MODEL=

# Mentions and reactions
# ASK_COOLDOWN_SECONDS=60
# LLM_CONTEXT_MESSAGES=0
# LLM_IMAGE_MAX_EDGE=1280
# LLM_MENTION_MAX_TOKENS=384
# LLM_REACTION_CHANCE=0.10
# LLM_REACTION_COOLDOWN_SECONDS=60

# Teases
# TEASE_LLM_ENHANCE=true
# Default: LLAMA_CPP_DEFAULT_MODEL.
# TEASE_LLAMA_CPP_MODEL=
# TEASE_LLAMA_CPP_TIMEOUT=45

# Flight tracker (SerpApi)
# SERPAPI_BASE_URL=https://serpapi.com/search.json
# SERPAPI_ACCOUNT_URL=https://serpapi.com/account.json
# SERPAPI_TIMEOUT=30
# SERPAPI_GL=ro
# SERPAPI_HL=en
# FLIGHT_CHECK_INTERVAL_HOURS=5
# FLIGHT_CHECK_GAP_SECONDS=1
# Fernet key that encrypts stored SerpApi keys; unset keeps them in plain text.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FLIGHT_CREDENTIALS_KEY=

# Wishlist
# WISHLIST_HISTORY_DAYS=180
